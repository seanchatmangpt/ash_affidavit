#
# Pin of everything scripts/consume.sh consumes. pack_commit is the marketplace commit that landed the pack
# (PR ggen-marketplace#557, base pack_base_commit); the pack is read from an export of exactly that commit.
# pack_fingerprint is scripts/pack_fingerprint.py over the pack directory (caches excluded); consume.sh refuses a stale
# one. Pins carry no authority: authority_ceiling stays NONE.
schema = "ash_affidavit.consumer-pack.pin/1"
pack = "qri-consumer-binding-pack"
pack_version = "26.9.30"
pack_commit = "20ff9279f4eaddc1e4fbf00f79ae6ad44c0f7732"
pack_base_commit = "80d429f13cc887f66855ba4029f6d83aa3a8098f"
pack_fingerprint = "sha256:35a75ac3b2cd65a80e3fdbc749ad8c447ba6c6ca02ad5c6d577a4f6fc8b164bf"
pack_content_digest = "f1015c198374e5e9b3bf629dabb90a90a32127f5a60caa57fcb3d9dc61568bda"
generator_version = "26.9.28"
affidavit_base_commit = "97e6b526b091bf5e0e0299a84d9bc74889e38522"
affidavit_commit = "4f654d21f3863ad89a11a62325c1dbf875cf72df"
artifact_sha256 = "5cc37aea8e59f7139e2ff5d43ab3c3c82931285b6400cf45f943c61d21a41402"
artifact_bytes = 660847
artifact_pin_registry_sha256 = "912c5a7c3d38fd053bb2c0fca8cc08bdc5138f9c9a08fb537f170342233355ee"
contract_digest = "f156c190c6c6dca0be78c88ca3cb9f7fe01fca2bf31d0523477978abd656ccd8"
authority_ceiling = "NONE"

# ash-extension-pack: source of the generated Spark/Igniter surface (scripts/render_extension.sh). The export is
# read at ext_pack_base_commit (== marketplace origin/main at the time; pack unchanged since) and refused unless its
# content digest equals the pin. No authority.
ext_pack = "ash-extension-pack"
ext_pack_version = "0.3.0"
ext_pack_base_commit = "80d429f13cc887f66855ba4029f6d83aa3a8098f"
ext_pack_content_digest = "978decb1f420589b5c0d1f714d54a5949b5f23c15feb27d88e414cb0e992635e"

