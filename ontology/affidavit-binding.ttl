# ConsumerBinding for ash_affidavit: contract (ontology/affidavit-contract.ttl) + chosen realization
# (beam-wasmex) + exact artifact pin + authorityCeiling NONE. Consumed by scripts/consume.sh together with the
# contract file; the pack (qri-consumer-binding-pack) projects lib/ from the pair. No authority is implied.
@prefix qcb:  <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#> .
@prefix qri:  <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#> .
@prefix ab:   <urn:qcb:binding:affidavit:> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

ab:binding a qcb:ConsumerBinding ;
    qcb:contract ab:contract ;
    qcb:chosenRealization ab:realization ;
    qcb:realizationProfile ab:profile ;
    qcb:artifactPin ab:pin ;
    qcb:requestedProjection "host" , "op-names" , "tests" ;
    qcb:authorityCeiling "NONE" ;
    qcb:logicalOperation ab:lop_capabilities , ab:lop_commit , ab:lop_assemble , ab:lop_verify , ab:lop_mine , ab:lop_conform , ab:lop_verify_signature_input , ab:lop_certify_authzen_evidence , ab:lop_certify_spiffe_evidence .

ab:realization a qri:Realization ; qri:implementsContract ab:contract .
ab:profile a qcb:RealizationProfile ; qcb:profileId "beam-wasmex" .

ab:lop_capabilities a qri:Operation ; qri:opName "capabilities" .
ab:lop_commit a qri:Operation ; qri:opName "commit" .
ab:lop_assemble a qri:Operation ; qri:opName "assemble" .
ab:lop_verify a qri:Operation ; qri:opName "verify" .
ab:lop_mine a qri:Operation ; qri:opName "mine" .
ab:lop_conform a qri:Operation ; qri:opName "conform" .
ab:lop_verify_signature_input a qri:Operation ; qri:opName "verify_signature_input" .
ab:lop_certify_authzen_evidence a qri:Operation ; qri:opName "certify_authzen_evidence" .
ab:lop_certify_spiffe_evidence a qri:Operation ; qri:opName "certify_spiffe_evidence" .

ab:pin a qcb:ArtifactPin ;
    qcb:checksum ab:checksum ;
    dcat:byteSize "660847"^^xsd:nonNegativeInteger ;
    dcat:mediaType "application/wasm" ;
    dcat:downloadURL "https://github.com/seanchatmangpt/affidavit/releases/download/v26.10.5/affidavit.wasm" ;
    owl:versionInfo "26.10.5" ;
    qcb:abiVersion "1" ;
    qcb:registrySha256 "2fcaae611aaf069317123c0e1fe0c2978b2bd9c72aeadf2888aaee8be34d2ee5" ;
    dcterms:provenance "local build of affidavit-wasm (cargo --target wasm32-wasip1 --profile wasm) from the affidavit checkout at 4f654d21f3863ad89a11a62325c1dbf875cf72df; pin equals affidavit-wasm/registry/ARTIFACTS.sha256 and registry/artifact-pin.json; ops add verify_signature and derive_subject_digest alongside certify_authzen_evidence and certify_spiffe_evidence; artifact.url is the intended release location and was NOT published or fetched by this build; the wasm is vendored in this package, so mix ash_affidavit.vendor --check needs no network" .

ab:checksum a spdx:Checksum ;
    spdx:algorithm spdx:checksumAlgorithm_sha256 ;
    spdx:checksumValue "5cc37aea8e59f7139e2ff5d43ab3c3c82931285b6400cf45f943c61d21a41402" .

