# Host-profile contract for the affidavit WASM engine (affidavit-wasm, ABI 1, wasm32-wasip1), bound by
# ontology/affidavit-binding.ttl. Values observed from the engine registry and the module's import/export
# sections. qri:contractDigest is the RDFC-1.0 sha256 of this contract's closure (see scripts/consume.sh).
# optionalExport _initialize is declared only because the host template fails to render without one.
# Grants no execution authority.
@prefix qcb:  <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#> .
@prefix qri:  <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#> .
@prefix ab:   <urn:qcb:binding:affidavit:> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

ab:capability a qri:Capability .

ab:contract a qri:CapabilityContract ;
    qri:contractDigest "f156c190c6c6dca0be78c88ca3cb9f7fe01fca2bf31d0523477978abd656ccd8" ;
    qcb:registrySha256 "2fcaae611aaf069317123c0e1fe0c2978b2bd9c72aeadf2888aaee8be34d2ee5" ;
    qri:specifiesCapability ab:capability ;
    qri:contractVersion "1.0.0" ;
    qri:abiSymbolPrefix "af" ;
    qri:abiKind "core-wasm-json" ;
    qri:abiVersion "1" ;
    qri:invariantSet ab:invariants ;
    qri:refusalScheme ab:refusals ;
    qri:hostProfile ab:host ;
    qri:allowedImport "wasi_snapshot_preview1::environ_get" ,
                      "wasi_snapshot_preview1::environ_sizes_get" ,
                      "wasi_snapshot_preview1::fd_write" ,
                      "wasi_snapshot_preview1::proc_exit" ,
                      "wasi_snapshot_preview1::random_get" ;
    qri:requiredExport "af_alloc" , "af_call" , "af_free" , "af_abi_version" , "memory" ;
    qri:optionalExport "_initialize" ;
    qri:wasiImport ab:impEnvironGet , ab:impEnvironSizesGet , ab:impFdWrite , ab:impProcExit , ab:impRandomGet ;
    qri:operation ab:opCall .

ab:opCall a qri:Operation ; qri:opName "call" ; qri:input ab:inRequest ; qri:output ab:outResponse .
ab:inRequest a qri:Field ; qri:fieldName "request" ; qri:fieldType "bytes" ; qri:fieldOrder 1 .
ab:outResponse a qri:Field ; qri:fieldName "response" ; qri:fieldType "bytes" ; qri:fieldOrder 1 .

ab:invariants a qri:InvariantSet ; qri:requiresInvariant ab:semanticResult , ab:refusalBoundary , ab:determinism .
ab:semanticResult a qri:Invariant ; qri:invariantKind qri:Semantic .
ab:refusalBoundary a qri:Invariant ; qri:invariantKind qri:Refusal .
ab:determinism a qri:Invariant ; qri:invariantKind qri:Determinism .

# Engine flat error codes (registry error_codes). Host-side refusals live in AshAffidavit.Refusal.
ab:refusals a skos:ConceptScheme .
ab:rBadJson a qri:RefusalCode , skos:Concept ; skos:inScheme ab:refusals ; qri:refusalCode "bad_json" .
ab:rMissingField a qri:RefusalCode , skos:Concept ; skos:inScheme ab:refusals ; qri:refusalCode "missing_field" .
ab:rUnknownOp a qri:RefusalCode , skos:Concept ; skos:inScheme ab:refusals ; qri:refusalCode "unknown_op" .
ab:rBadField a qri:RefusalCode , skos:Concept ; skos:inScheme ab:refusals ; qri:refusalCode "bad_field" .
ab:rTooLarge a qri:RefusalCode , skos:Concept ; skos:inScheme ab:refusals ; qri:refusalCode "too_large" .
ab:rTooDeep a qri:RefusalCode , skos:Concept ; skos:inScheme ab:refusals ; qri:refusalCode "too_deep" .
ab:rMissingBuffer a qri:RefusalCode , skos:Concept ; skos:inScheme ab:refusals ; qri:refusalCode "missing_buffer" .
ab:rInternal a qri:RefusalCode , skos:Concept ; skos:inScheme ab:refusals ; qri:refusalCode "internal" .
ab:rMalformed a qri:RefusalCode , skos:Concept ; skos:inScheme ab:refusals ; qri:refusalCode "malformed" .

ab:host a qri:HostProfile ;
    qri:freeSymbol "af_free" ; qri:freeArity 2 ; qri:lenType "u32" ;
    qri:allocZeroPolicy "refuse-resource_limit" ; qri:reqConsumed true ;
    qri:outMode "packed_u64" ; qri:errorCollapse "flat_code" ;
    qri:requestCap 16777216 ; qri:pathEnv "AFFIDAVIT_WASM_PATH" ;
    qri:manifestRel "priv/affidavit/MANIFEST.json" ; qri:wasmRel "priv/affidavit/affidavit.wasm" ;
    qri:manifestSchema "ash_affidavit.affidavit.manifest/v1" ; qri:pinFormat "sha256-hex" ;
    qri:moduleRoot "AshAffidavit" ; qri:taskModuleRoot "AshAffidavit" ; qri:otpApp "ash_affidavit" ;
    qri:handleNoun "engine" ; qri:taxonomyNamespace "chatman" ; qri:refusalModule "AshAffidavit.Refusal" ;
    qri:telemetryRoot "ash_affidavit" ; qri:okKey "ok" ; qri:opKey "op" ;
    qri:poolStrategy "rest_for_one" ; qri:poolSizeSource "schedulers_online" ;
    qri:engineId "Affidavit" ; qri:probeOp "capabilities" ; qri:probeExpectKey "abi_version" ;
    qri:recycleOn "abi_failure" , "call_exited" , "call_trapped" , "call_timeout" , "fuel_exhausted" ;
    qri:hostLimit ab:limFuelPerMs , ab:limInstantiateFuel , ab:limMemoryLimitBytes , ab:limRecycleBytes , ab:limMaxQueue , ab:limMaxResponseBytes , ab:limTableElements , ab:limInstances , ab:limTables , ab:limMemories , ab:limTimeoutMs , ab:limAbiTimeout , ab:limMargin , ab:limRetryBaseMs , ab:limRetryMaxMs , ab:limInitializeTimeoutMult , ab:limBackoffExpCap , ab:limMaxRedirects .

# Limits: ash_graphlaw defaults reused unchanged (the engine states stack_size_bytes 16 MiB and
# max_json_depth 64 itself; the host limits below bound the host side only).
ab:limFuelPerMs a qri:HostLimit ; qri:limitName "fuel_per_ms" ; qri:limitDefault 1000000 ; qri:limitOrder 1 .
ab:limInstantiateFuel a qri:HostLimit ; qri:limitName "instantiate_fuel" ; qri:limitDefault 1000000000 ; qri:limitOrder 2 .
ab:limMemoryLimitBytes a qri:HostLimit ; qri:limitName "memory_limit_bytes" ; qri:limitDefault 268435456 ; qri:limitOrder 3 .
ab:limRecycleBytes a qri:HostLimit ; qri:limitName "recycle_bytes" ; qri:limitDefault 134217728 ; qri:limitOrder 4 .
ab:limMaxQueue a qri:HostLimit ; qri:limitName "max_queue" ; qri:limitDefault 64 ; qri:limitOrder 5 .
ab:limMaxResponseBytes a qri:HostLimit ; qri:limitName "max_response_bytes" ; qri:limitDefault 33554432 ; qri:limitOrder 6 .
ab:limTableElements a qri:HostLimit ; qri:limitName "table_elements" ; qri:limitDefault 100000 ; qri:limitOrder 7 .
ab:limInstances a qri:HostLimit ; qri:limitName "instances" ; qri:limitDefault 10 ; qri:limitOrder 8 .
ab:limTables a qri:HostLimit ; qri:limitName "tables" ; qri:limitDefault 10 ; qri:limitOrder 9 .
ab:limMemories a qri:HostLimit ; qri:limitName "memories" ; qri:limitDefault 4 ; qri:limitOrder 10 .
ab:limTimeoutMs a qri:HostLimit ; qri:limitName "timeout_ms" ; qri:limitDefault 5000 ; qri:limitOrder 11 .
ab:limAbiTimeout a qri:HostLimit ; qri:limitName "abi_timeout" ; qri:limitDefault 1000 ; qri:limitOrder 12 .
ab:limMargin a qri:HostLimit ; qri:limitName "margin" ; qri:limitDefault 1000 ; qri:limitOrder 13 .
ab:limRetryBaseMs a qri:HostLimit ; qri:limitName "retry_base_ms" ; qri:limitDefault 500 ; qri:limitOrder 14 .
ab:limRetryMaxMs a qri:HostLimit ; qri:limitName "retry_max_ms" ; qri:limitDefault 30000 ; qri:limitOrder 15 .
ab:limInitializeTimeoutMult a qri:HostLimit ; qri:limitName "initialize_timeout_mult" ; qri:limitDefault 10 ; qri:limitOrder 16 .
ab:limBackoffExpCap a qri:HostLimit ; qri:limitName "backoff_exp_cap" ; qri:limitDefault 16 ; qri:limitOrder 17 .
ab:limMaxRedirects a qri:HostLimit ; qri:limitName "max_redirects" ; qri:limitDefault 5 ; qri:limitOrder 18 .

# WASI imports exactly as parsed from the module's import section (all (i32,...)->i32 except proc_exit).
ab:impEnvironGet a qri:WasiImport ; qri:importName "environ_get" ; qri:importParams "i32,i32" ; qri:importResults "i32" .
ab:impEnvironSizesGet a qri:WasiImport ; qri:importName "environ_sizes_get" ; qri:importParams "i32,i32" ; qri:importResults "i32" .
ab:impFdWrite a qri:WasiImport ; qri:importName "fd_write" ; qri:importParams "i32,i32,i32,i32" ; qri:importResults "i32" .
ab:impProcExit a qri:WasiImport ; qri:importName "proc_exit" ; qri:importParams "i32" ; qri:importResults "" .
ab:impRandomGet a qri:WasiImport ; qri:importName "random_get" ; qri:importParams "i32,i32" ; qri:importResults "i32" .
